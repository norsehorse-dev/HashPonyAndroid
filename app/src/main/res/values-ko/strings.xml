    <!-- Help for the 1.0 extras, and the Pony family list in Settings -->
    <string name="help_kits_title">알고리즘 세트</string>
    <string name="help_kits_body">세트를 골라 계산할 항목을 정합니다: 다운로드(SHA-256, SHA-512, SHA-1, MD5), 포렌식(MD5, SHA-1, SHA-256), 전체. 설정의 알고리즘 화면에서 알고리즘을 직접 켜거나 끄면 그 선택이 사용자 지정으로 저장됩니다.</string>
    <string name="help_compare_title">값 확인</string>
    <string name="help_compare_body">공개된 값을 비교 칸에 붙여넣거나 스캔하세요. 일치하면 해당 해시값이 초록색으로 바뀝니다. 일치하는 값이 없으면 HashPony가 길이가 같은 가장 가까운 해시값을 보여 주고 다른 글자를 모두 표시합니다.</string>
    <string name="help_qr_title">QR 코드</string>
    <string name="help_qr_body">해시값을 길게 누르고 QR 코드 보이기를 선택하면 다른 기기에서 스캔할 수 있습니다. 비교 칸의 스캔 버튼은 Binary Eye처럼 이미 설치된 스캐너 앱을 엽니다. HashPony 자체는 카메라를 전혀 쓰지 않습니다.</string>
    <string name="help_receipt_title">검증 기록</string>
    <string name="help_receipt_body">검증을 마친 뒤, 모든 파일의 결과와 해시값, 확인 일시가 담긴 일반 텍스트 기록을 공유하거나 저장할 수 있습니다.</string>
    <string name="help_tile_title">빠른 설정 타일</string>
    <string name="help_tile_body">파일 해시 타일을 빠른 설정에 추가하면 어디서든 파일 선택기를 열 수 있습니다.</string>
    <string name="family_pgpony">메시지와 파일을 위한 OpenPGP 암호화.</string>
    <string name="family_passpony">보관함을 내 기기에만 두는 비밀번호 관리자.</string>
    <string name="family_vaultpony">직접 관리하는 VeraCrypt 호환 암호화 금고.</string>
    <string name="family_agepony">age 프로토콜을 이용한 최신 파일 암호화와 서명.</string>
    <string name="family_carrierpony">종단 간 봉인된 개인 메시지와 파일 전송.</string>
    <string name="family_burnpony">링크로 열리는 자동 소멸 암호화 메모.</string>
    <string name="family_relaypony">폰에서 폰으로, 암호화된 파일 전송.</string>
    <string name="family_quorumpony">Shamir 비밀 공유: 비밀을 카드로 나누고, 그중 몇 장으로 다시 복원합니다.</string>
    <string name="family_scrubpony">JPEG 파일에서 신원을 드러내는 메타데이터를 제거합니다.</string>
    <string name="family_tappony">NFC 태그를 탭해 내 서버로 요청을 보냅니다.</string>

