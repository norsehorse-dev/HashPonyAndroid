    <string name="help_files_title">Archivos</string>
    <string name="help_files_body">Elige archivos o una carpeta entera, o compártelos desde otra app. Cada archivo muestra sus hashes a medida que se calculan; toca un hash para copiarlo. Pega un valor esperado en el campo de comparación para comprobar una descarga.</string>
    <string name="help_verify_title">Verificar</string>
    <string name="help_verify_body">Indica a HashPony la carpeta en la que descargaste los archivos. Encuentra el archivo de sumas y comprueba cada entrada, marcando cada archivo como OK, Fallido o Falta.</string>
    <string name="help_text_title">Texto</string>
