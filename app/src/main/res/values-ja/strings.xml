    <string name="about_version">HashPony %1$s</string>
    <string name="about_body">HashPony は権限を一切必要とせず、オフラインで動作します。共有や保存をしない限り、端末から何も出ていきません。</string>
    <string name="licenses_title">オープンソースライセンス</string>
